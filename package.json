{
  "name": "mapgen",
  "version": "0.1.0",
  "description": "Code-drawn, true top-down D&D battle maps with a hand-drawn look.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattj7820/MapGen.git"
  },
  "scripts": {
    "map": "tsx src/cli/bin/map.ts",
    "render": "tsx src/cli/bin/render.ts",
    "restyle": "tsx src/cli/bin/restyle.ts",
    "props": "tsx src/cli/bin/props.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "d3-delaunay": "^6.0.4",
    "simplex-noise": "^4.0.3"
  }
}
